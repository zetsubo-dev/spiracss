{
  "semi": false,
  "arrowParens": "always",
  "printWidth": 120,
  "singleQuote": true,
  "trailingComma": "none",
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "out/**",
    "build/**",
    "coverage/**",
    "docs/**",
    "official-site/**",
    "starters/**",
    "template/**",
    "figma-to-spiracss/**"
  ]
}
