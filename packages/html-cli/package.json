{
  "name": "@spiracss/html-cli",
  "version": "0.6.0",
  "description": "SpiraCSS CLI for HTML-to-SCSS generation, structure linting, and placeholder formatting.",
  "homepage": "https://spiracss.jp",
  "repository": {
    "type": "git",
    "url": "https://github.com/zetsubo-dev/spiracss.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "keywords": [
    "spiracss",
    "spira",
    "scss",
    "css",
    "bem",
    "smacss",
    "rscss",
    "html",
    "cli",
    "generator",
    "lint",
    "format"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "default": "./dist/eslint.js"
    }
  },
  "bin": {
    "spiracss-html-format": "./dist/html-format.js",
    "spiracss-html-lint": "./dist/html-lint.js",
    "spiracss-html-to-scss": "./dist/cli.js"
  },
  "scripts": {
    "build": "node esbuild.js --production && tsc -p tsconfig.json --emitDeclarationOnly",
    "prepublishOnly": "pnpm run build",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "check-types": "tsc --noEmit",
    "lint": "oxlint src test --quiet",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "TS_NODE_TRANSPILE_ONLY=1 mocha -r ts-node/register \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "@babel/parser": "7.29.11",
    "@astrojs/compiler": "4.0.0",
    "@vue/compiler-dom": "3.5.45",
    "cheerio": "^1.2.0",
    "domhandler": "^5.0.3",
    "entities": "6.0.1",
    "parse5": "7.3.0"
  },
  "devDependencies": {
    "@html-eslint/parser": "0.68.0",
    "@typescript-eslint/parser": "8.72.1",
    "astro-eslint-parser": "3.2.0",
    "vue-eslint-parser": "10.4.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.12.4",
    "esbuild": "^0.25.1",
    "eslint": "10.14.0",
    "mocha": "^11.1.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.65.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@11.28.5"
}
