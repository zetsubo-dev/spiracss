{
  "name": "@spiracss/stylelint-plugin",
  "version": "0.4.5",
  "type": "module",
  "description": "Stylelint plugin enforcing SpiraCSS conventions for class structure, property placement, interaction scope/properties, keyframes naming, pseudo nesting, page layer, and rel-comment links.",
  "homepage": "https://spiracss.jp",
  "repository": {
    "type": "git",
    "url": "https://github.com/zetsubo-dev/spiracss.git"
  },
  "keywords": [
    "spiracss",
    "stylelint",
    "stylelint-plugin",
    "css",
    "bem",
    "smacss",
    "rscss",
    "scss",
    "lint",
    "architecture"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "types": "dist/esm/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./helpers": {
      "types": "./dist/esm/helpers.d.ts",
      "default": "./dist/esm/helpers.js"
    },
    "./types": {
      "types": "./dist/esm/types.d.ts",
      "default": "./dist/esm/types.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.esm.json && node scripts/fix-esm-output.mjs",
    "prepublishOnly": "pnpm run build",
    "pretest": "pnpm run build",
    "test": "TSX_TSCONFIG_PATH=tsconfig.test.json node --import tsx ./scripts/run-mocha.mjs \"__tests__/**/*.test.ts\"",
    "lint": "oxlint src __tests__ --quiet",
    "lint:test": "stylelint \"test/fixtures/**/*.scss\" --config stylelint.config.js",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "postcss-selector-parser": "^7.1.1",
    "postcss-value-parser": "^4.2.0",
    "safe-regex": "^2.1.1"
  },
  "peerDependencies": {
    "stylelint": "^17.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.12.4",
    "@types/safe-regex": "^1.1.6",
    "mocha": "^11.7.5",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "postcss": "^8.4.49",
    "postcss-scss": "^4.0.9",
    "stylelint": "^17.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@11.1.2"
}
