{
  "name": "spiracss-comment-links",
  "displayName": "SpiraCSS Comment Links",
  "description": "VS Code extension that opens SpiraCSS link comments in SCSS.",
  "homepage": "https://spiracss.jp",
  "repository": {
    "type": "git",
    "url": "https://github.com/zetsubo-dev/spiracss.git"
  },
  "version": "0.4.5",
  "license": "MIT",
  "publisher": "spiracss",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "spiracss",
    "spira",
    "scss",
    "css",
    "comment",
    "link",
    "navigation",
    "components",
    "assets",
    "alias"
  ],
  "activationEvents": [
    "onLanguage:scss"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production && node -e \"require('fs').mkdirSync('build',{recursive:true})\" && pnpm exec vsce package --no-dependencies --out build/spiracss-comment-links-$(node -p \"require('./package.json').version\").vsix",
    "check-types": "tsc --noEmit",
    "lint": "oxlint src --quiet",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.12.4",
    "@types/vscode": "^1.99.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.7.0",
    "esbuild": "^0.25.1",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@11.1.2"
}
